{
  "name": "Alveron Email Send",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 5 }
          ]
        }
      },
      "id": "e1",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:3100/api/webhook/outreach-queue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Key", "value": "={{ $env.ALVERON_WEBHOOK_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "e2",
      "name": "Get Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "items"
      },
      "id": "e3",
      "name": "Split Out Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:3100/api/webhook/outreach/{{ $json.outreach_id }}/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Key", "value": "={{ $env.ALVERON_WEBHOOK_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message_id: $json.message_id }) }}",
        "options": {
          "response": {
            "response": { "neverError": true }
          }
        }
      },
      "id": "e4",
      "name": "Send via Alveron API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "e5c",
              "leftValue": "={{ $json.code }}",
              "rightValue": "outreach_paused",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "e5",
      "name": "Paused?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 0]
    }
  ],
  "connections": {
    "Every 5 minutes": { "main": [[{ "node": "Get Queue", "type": "main", "index": 0 }]] },
    "Get Queue": { "main": [[{ "node": "Split Out Items", "type": "main", "index": 0 }]] },
    "Split Out Items": { "main": [[{ "node": "Send via Alveron API", "type": "main", "index": 0 }]] },
    "Send via Alveron API": { "main": [[{ "node": "Paused?", "type": "main", "index": 0 }]] },
    "Paused?": { "main": [[], []] }
  },
  "settings": { "executionOrder": "v1" }
}
