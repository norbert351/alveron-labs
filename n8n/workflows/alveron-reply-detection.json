{
  "name": "Alveron Reply Detection",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 15 }
          ]
        }
      },
      "id": "r1",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:3100/api/webhook/email-accounts-for-polling",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Key", "value": "={{ $env.ALVERON_WEBHOOK_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "r2",
      "name": "Get Connected Accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "accounts"
      },
      "id": "r3",
      "name": "Split Accounts",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:3100/api/webhook/email-accounts/{{ $json.id }}/poll-replies",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Key", "value": "={{ $env.ALVERON_WEBHOOK_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "r4",
      "name": "Poll Replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, scanned: $json.scanned || 0, applied: $json.applied || 0 }) }}",
        "options": {}
      },
      "id": "r5",
      "name": "Report",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 0]
    }
  ],
  "connections": {
    "Every 15 minutes": { "main": [[{ "node": "Get Connected Accounts", "type": "main", "index": 0 }]] },
    "Get Connected Accounts": { "main": [[{ "node": "Split Accounts", "type": "main", "index": 0 }]] },
    "Split Accounts": { "main": [[{ "node": "Poll Replies", "type": "main", "index": 0 }]] },
    "Poll Replies": { "main": [[{ "node": "Report", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
