# Copy to .env and replace every CHANGE_ME value before starting n8n.
# Never commit .env or paste production secrets into GitHub.

# Public hostname served by your HTTPS reverse proxy, without a scheme.
N8N_HOST=automation.example.com
N8N_PORT=5678
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_a_long_random_secret

# Dedicated PostgreSQL database used only by n8n.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_generate_a_strong_password

GENERIC_TIMEZONE=Africa/Lagos

# Alveron API runs on the VPS host, separately from this Compose project.
# The API currently listens on 0.0.0.0:3100, so Docker can reach it via host-gateway.
ALVERON_API_BASE=http://host.docker.internal:3100
ALVERON_API_URL=http://host.docker.internal:3100
ALVERON_INTERNAL_TOKEN=CHANGE_ME_match_api_internal_token
ALVERON_WEBHOOK_TOKEN=CHANGE_ME_match_api_webhook_token

# Optional delivery integration. The intelligence engine does not depend on Telegram.
ALVERON_TELEGRAM_BOT_TOKEN=
ALVERON_TELEGRAM_CHAT_ID=

# Optional email delivery endpoint. Use a provider endpoint reachable from n8n.
EMAIL_PROVIDER_URL=http://host.docker.internal:3199/send
EMAIL_FROM=outreach@alveronlabs.dev
