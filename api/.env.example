ALVERON_DATABASE_URL=postgres://alveron:CHANGE_ME@127.0.0.1:5433/alveron
ALVERON_PORT=3100
ALVERON_LLM_API_KEY=CHANGE_ME
ALVERON_LLM_MODEL=gpt-5.6-terra
ALVERON_LLM_TIMEOUT_MS=180000
ALVERON_INTERNAL_TOKEN=CHANGE_ME
ALVERON_WEBHOOK_TOKEN=CHANGE_ME
ALVERON_RATE_LIMIT_MAX=120
ALVERON_RATE_LIMIT_WINDOW_MS=60000

ENCRYPTION_KEY=base64-32-random-bytes-required-for-oauth-token-encryption
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:3100/api/email-accounts/oauth/callback/gmail
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://127.0.0.1:3100/api/email-accounts/oauth/callback/microsoft
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# =====================================================================
# Phase 12 — Global Automated Research Engine
# =====================================================================
# AI reasoning layer (Groq). Without GROQ_API_KEY the engine still runs
# discovery, crawling, evidence and deterministic findings; AI problem
# detection / opportunity formulation are skipped and logged as
# AI_NOT_CONFIGURED (never faked).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=60000
GROQ_MAX_RETRIES=3
GROQ_MIN_SPACING_MS=250

# Discovery (Overpass/OSM is credential-free; add keys only for providers you wire up)
ALVERON_DISCOVERY_PROVIDER=overpass
ALVERON_OVERPASS_URL=https://overpass-api.de/api/interpreter
ALVERON_NOMINATIM_URL=https://nominatim.openstreetmap.org
ALVERON_CONTACT_EMAIL=research@alveronlabs.dev
ALVERON_DISCOVERY_TIMEOUT_MS=120000
ALVERON_DISCOVERY_MAX_RESULTS=400

# Tiered crawler limits / safety
ALVERON_CRAWL_MAX_PAGES=12
ALVERON_CRAWL_MAX_BYTES=3000000
ALVERON_CRAWL_TIMEOUT_MS=20000
ALVERON_CRAWL_MAX_DEPTH=2
ALVERON_CRAWL_CONCURRENCY_HTTP=6
ALVERON_CRAWL_CONCURRENCY_BROWSER=1
ALVERON_CRAWL_RESPECT_ROBOTS=true
ALVERON_CRAWL_SCREENSHOTS=false
ALVERON_SCREENSHOT_DIR=/tmp/alveron-screenshots

# Research-run control (idempotency + safety)
ALVERON_RESEARCH_RE_CRAWL_DAYS=7
ALVERON_RESEARCH_COMPANY_CONCURRENCY=2
ALVERON_RESEARCH_COMPANY_TIMEOUT_MS=180000

# n8n orchestration (import the 8 research-* workflows; workflows read these at launch)
N8N_BASE_URL=http://127.0.0.1:5678
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
ALVERON_API_BASE=http://127.0.0.1:3100
